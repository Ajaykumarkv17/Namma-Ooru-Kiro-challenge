# Copy this file to .env for local, non-production configuration.
# Keep .env local: it is ignored by Git. AWS authentication is resolved through
# the standard AWS credential chain (profile, SSO, or IAM role); do not add
# access keys or secret keys to this file.

# Application runtime
APP_ENV=development
AWS_REGION=ap-south-1
AI_PROVIDER=mock

# Local service endpoints
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional deployed AI and data resource identifiers (non-secret)
# Generation uses inference-profile IDs; Titan is reserved for Knowledge Base embeddings.
BEDROCK_PRIMARY_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_KB_ID=
KB_S3_BUCKET=

# Optional MCP configuration. Set a personal access token only in your local .env.
GITHUB_PERSONAL_ACCESS_TOKEN=
